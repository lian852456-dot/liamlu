(!view.available){$('tradeinMeta').innerHTML='';target.innerHTML='<div class=\"empty\">尚未發布正式資料：舊換新。</div>';return;}\n    $('tradeinMeta').innerHTML=metaHtml(view.meta);\n    if(!view.rows.length){target.innerHTML='<div class=\"empty\">沒有符合搜尋條件的正式機款。</div>';return;}\n    const notice=view.limited?`<div class=\"status warn\">目前顯示前 ${view.displayLimit} 筆（符合條件共 ${view.totalRows} 筆）。請先從「選機款」縮小範圍後查看完整資料。</div>`:'';\n    const selectedProvider=$('tradeinProvider').value,selectedGrade=$('tradeinGrade').value;\n    target.innerHTML=notice+view.rows.map(row=>`<article class=\"provider\"><h3>${esc([row.brand,row.model].filter(Boolean).join(' · ')||'未命名機款')}</h3>${row.priceVariant?`<p class=\"price-variant\">不同報價：${row.sourceModels.map(esc).join('／')}</p>`:''}<p class=\"group-note\">來源工作表：${esc(row.sourceSheet||'—')}<br>原始機型：${row.sourceModels.map(esc).join('／')}</p>${Core.quotedProviders(row,selectedProvider,selectedGrade).map(provider=>{const grades=Core.quotedGrades(row,provider,selectedGrade);return `<div class=\"table-scroll\"><table><thead><tr><th colspan=\"${grades.length+1}\">${esc(provider)}（獨立報價）</th></tr><tr><th>原始機型／容量</th>${grades.map(grade=>`<th>${esc(Core.gradeLabel(grade))}</th>`).join('')}</tr></thead><tbody><tr><td>${esc(row.model||'—')}</td>${grades.map(grade=>`<td>${esc(Core.formatPrice(row.quotes[provider]&&row.quotes[provider][grade]))}</td>`).join('')}</tr></tbody></table></div>`;}).join('')}</article>`).join('');\n  }\n  function renderKind(kind){if(kind==='shopping'){if(shoppingIndex)updateShoppingOptions();renderShopping();renderChanges(kind);return;}const search=$('tradeinSearch').value,modelKey=$('tradeinModel').value;const response=state[kind];const view=response?Core.buildView(kind,response,{query:search,modelKey,provider:$('tradeinProvider').value,grade:$('tradeinGrade').value}):null;renderTradein(view);renderChanges(kind);if(view){const select=$('tradeinModel'),prior=select.value;select.innerHTML='<option value=\"\">全部機款</option>'+view.modelOptions.map(option=>`<option value=\"${esc(option.value)}\">${esc(option.label)}</option>`).join('');if(view.modelOptions.some(option=>option.value===prior))select.value=prior;}}\n  function showKind(kind){state.active=kind;['shopping','tradein'].forEach(value=>{const active=value===kind;$(value+'Tab').classList.toggle('active',active);$(value+'Tab').setAttribute('aria-selected',String(active));$(value+'Pane').classList.toggle('hidden',!active);});}\n  async function refresh(){\n    const requestGeneration=++generation;\n    state.loading=true;$('refreshBtn').disabled=true;setStatus('正在讀取內嵌價格…');clearResults();\n    const outcomes={};\n    function progress(){\n      // Each route presents its own price category. The shared reader keeps\n      // the existing payload/transport and other-category state unchanged.\n      const result=outcomes[queryKind];\n      if(!result){setStatus('正在準備本機查詢…');return;}\n      const name=queryKind==='shopping'?'手機專案價查詢':'回收價查詢';\n      if(result.error){setStatus(name+'：'+result.error+'；正式資料已清除，請重新整理。','bad');return;}\n      const available=!!state[queryKind]?.snapshot;\n      setStatus(available?'離線唯讀版已就緒；價格依本檔來源版本。':name+' 尚未發布正式資料。',available?'ok':'warn');\n    }\n    try{\n      await Promise.all(['shopping','tradein'].map(async kind=>{\n        try{\n          const response=await invoke(kind);\n          if(requestGeneration!==generation)return;\n          const index=kind==='shopping'?Compare.buildIndex(response.snapshot||{}):null;\n          state[kind]=response;if(kind==='shopping'){shoppingIndex=index;splitSpecKeys=findSplitSpecs(index);}\n          outcomes[kind]={};renderKind(kind);\n        }catch(error){\n          if(requestGeneration!==generation)return;\n          outcomes[kind]={error:String(error.message||'正式資料讀取失敗')};\n        }\n        if(requestGeneration===generation)progress();\n      }));\n    }finally{if(requestGeneration===generation){state.loading=false;$('refreshBtn').disabled=false;requestAnimationFrame(()=>{const timing=document.getElementById('localTiming');if(!timing.dataset.ready){timing.textContent='本次開啟至可查詢：'+Math.round(performance.now())+' ms（此裝置實測）';timing.dataset.ready='true';}});}}\n  }\n  function bind(){\n    $('consumerSegmentBtn').addEventListener('click',()=>setShoppingSegment('consumer'));$('enterpriseSegmentBtn').addEventListener('click',()=>setShoppingSegment('enterprise'));\n    $('refreshBtn').addEventListener('click',refresh);\n    $('tradeinReset').addEventListener('click',()=>{['tradeinSearch','tradeinBrand','tradeinModel','tradeinProvider','tradeinGrade'].forEach(id=>$(id).value='');renderKind('tradein');});\n    document.querySelectorAll('[data-kind]').forEach(button=>button.addEventListener('click',()=>showKind(button.dataset.kind)));\n    ['shoppingBrand','shoppingModel','shoppingCapacity','shoppingProject','shoppingVersion','shoppingRent','shoppingTerm'].forEach(id=>$(id).addEventListener('change',()=>{rowPage=0;columnPage=0;renderKind('shopping');}));\n    // Catalog options do not depend on the search query; keep select updates on filter changes.\n    $('shoppingSearch').addEventListener('input',()=>{rowPage=0;columnPage=0;renderShopping();renderChanges('shopping');});\n    ['tradeinSearch','tradeinModel','tradeinProvider','tradeinGrade'].forEach(id=>$(id).addEventListener(id.endsWith('Search')?'input':'change',()=>renderKind('tradein')));\n    $('shoppingReset').addEventListener('click',()=>{['shoppingSearch','shoppingBrand','shoppingModel','shoppingCapacity','shoppingProject','shoppingVersion','shoppingTerm'].forEach(id=>$(id).value='');$('shoppingRent').value=shoppingSegment==='enterprise'?'':'common';rowPage=0;columnPage=0;renderKind('shopping');});\n    document.querySelectorAll('[data-shortcut]').forEach(button=>button.addEventListener('click',()=>{const value=button.dataset.shortcut;const [rent,term]=value.split('-');$('shoppingRent').value=rent;$('shoppingTerm').value=term||'';$('shoppingVersion').value='';rowPage=0;columnPage=0;renderKind('shopping');}));\n    $('tableModeBtn').addEventListener('click',()=>setReadingMode('table'));$('cardModeBtn').addEventListener('click',()=>setReadingMode('card'));$('shoppingCardCondition').addEventListener('change',()=>{rowPage=0;renderShopping();});\n    [['rowPrev','row',-1],['rowNext','row',1],['columnPrev','column',-1],['columnNext','column',1]].forEach(([id,axis,direction])=>$(id).addEventListener('click',()=>{if(axis==='row')rowPage+=direction;else{columnPage+=direction;rowPage=0;}renderShopping();}));\n    if(scope.matchMedia('(max-width:700px)').matches)document.querySelector('.filter-details').open=false;\n    setShoppingSegment(shoppingSegment);setReadingMode(readingMode);\n    scope.addEventListener('pagehide',()=>{generation+=1;clearResults();});\n    scope.addEventListener('pageshow',event=>{if(event.persisted)refresh();});\n    showKind(queryKind);\n    refresh();\n  }\n  if(!Core||!Compare||!Transport){setStatus('查詢元件載入失敗。','bad');return;}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind);else bind();\n})(window);\n</script>\n<script>(function(scope){\n  'use strict';\n  // Presentation only. Keep the accepted prices, filters and clearing lifecycle unchanged.\n  // Each existing item becomes one aligned comparison panel; distinct items are never merged.\n  const target=document.getElementById('tradeinResults')||document.getElementById('results');\n  if(!target)return;\n  const ORDER=['S','A','B','C','未分級'];\n  const node=(tag,cls,value)=>{const el=document.createElement(tag);el.className=cls;if(value!=null)el.textContent=value;return el;};\n  const grade=value=>String(value||'').includes('未分級')?'未分級':(String(value||'').match(/^\\s*([SABC])\\s*級?\\s*$/)||[])[1];\n  function providerLabel(heading){\n    const full=heading.textContent;\n    const plain=full.replace(/[（(]\\s*獨立報價\\s*[）)]/g,'').trim();\n    const short=/FutureDial|FDI/i.test(plain)?'FDI':plain;\n    const original=node('span','tc-sr',full),display=node('span','tc-provider-label',short);\n    display.setAttribute('aria-hidden','true');\n    heading.replaceChildren(original,display);heading.title=plain;\n    heading.classList.add('tc-provider');\n  }\n  function priceCell(cell,g){\n    const value=cell.textContent;\n    const match=value.match(/^(.*?)\\s*(元)\\s*$/);\n    if(match){cell.replaceChildren(node('span','tc-number',match[1]),node('span','tc-sr',' 元'));}\n    cell.classList.add('tc-cell');cell.dataset.grade=g;\n    // No numeric parsing, rounding, currency conversion or zero/missing substitution.\n  }\n  function enhance(card){\n    if(card.dataset.compactVersion)return;\n    const external=card.classList.contains('model-card');\n    const blocks=Array.from(card.querySelectorAll(external?':scope > .provider-block':':scope > .table-scroll'));\n    if(!blocks.length)return;\n    const rows=[];\n    for(const block of blocks){\n      const heading=block.querySelector(external?'.provider-title':'thead tr:first-child th');\n      if(!heading)return;\n      const cells=[];\n      if(external){\n        for(const item of block.querySelectorAll('.price-item')){\n          const g=grade(item.querySelector('.grade')?.textContent),cell=item.querySelector('strong');\n          if(!g||!cell)return;\n          cells.push({g,cell});\n        }\n      }else{\n        const headers=Array.from(block.querySelectorAll('thead tr:last-child th')).slice(1);\n        const prices=Array.from(block.querySelectorAll('tbody tr:first-child td')).slice(1);\n        if(headers.length!==prices.length)return;\n        for(let i=0;i<headers.length;i++){\n          const g=grade(headers[i].textContent);if(!g)return;cells.push({g,cell:prices[i]});\n        }\n      }\n      if(!cells.length)return;\n      rows.push({block,heading,cells});\n    }\n    const columns=ORDER.filter(g=>rows.some(row=>row.cells.some(cell=>cell.g===g)));\n    if(!columns.length)return;\n    // Only enhance a completely recognized render, before modifying any original nodes.\n    card.dataset.compactVersion='20261012-1';card.classList.add('tc-item');\n    const title=card.querySelector('h3');\n    if(title){\n      const parts=title.textContent.split(/\\s*·\\s*/);\n      if(parts.length===2&&parts[1].toLocaleLowerCase().startsWith(parts[0].toLocaleLowerCase()+' '))title.textContent=parts[1];\n    }\n    const wrap=node('div','tc-prices'),matrix=node('div','tc-matrix');\n    matrix.style.setProperty('--tc-columns',String(columns.length));\n    const wide=columns.length>4||rows.some(row=>row.cells.some(({cell})=>cell.textContent.replace(/\\s*元\\s*$/,'').length>6));\n    if(wide){matrix.classList.add('tc-wide');wrap.tabIndex=0;wrap.setAttribute('role','region');wrap.setAttribute('aria-label','回收價比較，可左右滑動');}\n    const header=node('div','tc-grade-head');header.setAttribute('aria-hidden','true');\n    header.append(node('span','tc-heading-provider','回收商'));\n    columns.forEach(g=>header.append(node('span','tc-heading-grade',g==='未分級'?'未分級':g+'級')));\n    matrix.append(header);wrap.append(matrix);\n    const note=node('p','tc-unit','單位：元；－ 表示該等級未提供報價');\n    const first=rows[0].block;\n    card.insertBefore(note,first);card.insertBefore(wrap,first);\n    for(const {block,heading,cells} of rows){\n      block.classList.add('tc-provider-row');providerLabel(heading);\n      if(!external){\n        const table=block.querySelector('table');table.classList.add('tc-original-table');\n        table.setAttribute('aria-label',(title?.textContent||'機款')+' '+heading.title+' 報價');\n        block.querySelector('thead tr:last-child').classList.add('tc-original-grades');\n        block.querySelector('tbody tr:first-child td').classList.add('tc-repeat-model');\n      }\n      for(const {g,cell} of cells){priceCell(cell,g);cell.style.gridColumn=String(columns.indexOf(g)+2);}\n      const missingParent=external?block.querySelector('.price-grid'):block.querySelector('tbody tr');\n      for(const g of columns){\n        if(cells.some(cell=>cell.g===g))continue;\n        const missing=node(external?'span':'td','tc-cell tc-missing','－');\n        missing.dataset.grade=g;missing.style.gridColumn=String(columns.indexOf(g)+2);\n        missing.setAttribute('aria-label',g+'級未提供報價');missingParent.append(missing);\n      }\n      matrix.append(block);\n    }\n    const source=card.querySelector(':scope > .group-note');\n    if(source){const details=node('details','tc-source');details.append(node('summary','','來源資訊'),source);card.append(details);}\n    if(wide)card.append(node('p','tc-scroll-tip','左右滑動比較完整等級與金額'));\n  }\n  function update(){\n    target.querySelectorAll('article.provider, article.model-card').forEach(enhance);\n  }\n  document.body.dataset.tradeinCompact='true';\n  // Observe only the result root. Our own nested layout changes cannot trigger a loop.\n  const observer=new MutationObserver(update);observer.observe(target,{childList:true});\n  update();\n})(window);\n</script></body>\n</html>\n"};
