diff --git a/report-automation/work/source_date_range.test.mjs b/report-automation/work/source_date_range.test.mjs
new file mode 100644
--- /dev/null
+++ b/report-automation/work/source_date_range.test.mjs
@@ -0,0 +1,34 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+  dataCutoffDateFromSourceRange,
+  extractSourceDateRange,
+} from './source_date_range.mjs';
+
+test('完整與月內簡寫 source_date_range 都以資料截止日為準', () => {
+  assert.equal(dataCutoffDateFromSourceRange('2026/08/01 ~ 2026/08/21', '2026-08-22'), '2026-08-21');
+  assert.equal(dataCutoffDateFromSourceRange('2026/08/01~08/21', '2026-08-22'), '2026-08-21');
+  assert.equal(dataCutoffDateFromSourceRange('2026/08/01 ～ 08/21', '2026-08-22'), '2026-08-21');
+  assert.equal(
+    extractSourceDateRange([['說明'], ['2026/08/01～08/21']], '2026-08-22'),
+    '2026/08/01～08/21',
+  );
+});
+
+test('檔名、空值、無效、逆序、跨年歧義與未來 source_date_range 都 fail-closed', () => {
+  for (const value of [
+    '0822.xlsx',
+    '',
+    '2026/08/01~08/32',
+    '2026/08/21~08/01',
+    '2026/12/31~01/01',
+    '2026/08/01~08/23',
+  ]) {
+    assert.throws(
+      () => dataCutoffDateFromSourceRange(value, '2026-08-22'),
+      /source_date_range blocked/,
+      value,
+    );
+  }
+  assert.equal(extractSourceDateRange([['0822.xlsx'], ['2026/08/21~08/01']], '2026-08-22'), '');
+});
